{
  "manifest_version": 3,
  "name": "YouTube écran secondaire",
  "version": "1.7.5",
  "description": "Envoie uniquement l'onglet de la vidéo en plein écran sur l'écran secondaire.",
  "permissions": ["tabs", "scripting", "system.display", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Plein écran sur l'écran secondaire",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
